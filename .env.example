# This repository does not load a root .env file.
# Copy the package examples and fill them locally. Do not commit the copies.
#
#   cp backend/.env.example backend/.env
#   cp database/.env.example database/.env
#   cp frontend/.env.example frontend/.env
#
# backend/.env and database/.env must use the same DATABASE_URL.
# Values below are placeholders, not working secrets.

# backend/.env and database/.env
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/travel_platform

# backend/.env
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECRET=replace-with-a-long-random-string
NODE_ENV=development

# frontend/.env (optional)
# When unset, the Vite dev server proxies /api to http://127.0.0.1:4000.
VITE_API_URL=http://localhost:4000
